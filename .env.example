# URL de ton projet Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Cle publique cote client. Accepte deux formats :
# - ancien format JWT (anon key) : eyJhbGci...
# - nouveau format (recommande par Supabase depuis 2026) : sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
